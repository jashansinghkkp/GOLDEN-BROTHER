# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_TOKEN=replace-with-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-key
DATABASE_URL=sqlite:///./golden_brother.db
# Keep false until SmartAPI app, account authorization, static IP and risk controls are verified.
LIVE_TRADING_ENABLED=false
# Set the public HTTPS URL after deploying to Render.
PUBLIC_BASE_URL=https://your-service.onrender.com
# Optional comma-separated origins; use your frontend domain in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
